# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (start XAMPP MySQL first)
MYSQL_DATABASE=jofa
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=jofaskincare@gmail.com

# AI Skin Consultation — Google Gemini
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Payments / multi-vendor: cod (default) | stripe | simulate
PAYMENT_PROVIDER=cod
PAYMENT_CURRENCY=XAF
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=xaf

# Delivery: manual or mock_courier
DELIVERY_PROVIDER=manual
DELIVERY_CARRIER_NAME=Partner Courier
